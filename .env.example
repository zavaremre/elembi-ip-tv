# TMDB — https://www.themoviedb.org/settings/api
TMDB_TOKEN=
TMDB_KEY=
TMDB_LANG=tr-TR
TMDB_REGION=TR

# Xtream / IPTV sağlayıcı
XTREAM_HOST=
XTREAM_USER=
XTREAM_PASS=
XTREAM_OUTPUT=hls

# OpenSubtitles (otomatik altyazı) — https://www.opensubtitles.com/consumers
OPENSUBTITLES_KEY=
# Hesapla giriş indirme kotasını yükseltir (isteğe bağlı)
OPENSUBTITLES_USER=
OPENSUBTITLES_PASS=
# Çok sesli dosyalar için harici oynatıcı (macOS uygulama adı)
EXTERNAL_PLAYER=VLC
