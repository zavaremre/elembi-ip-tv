# TMDB — https://www.themoviedb.org/settings/api
TMDB_TOKEN=
TMDB_KEY=
TMDB_LANG=tr-TR
TMDB_REGION=TR

# Xtream / IPTV sağlayıcı
XTREAM_HOST=
XTREAM_USER=
XTREAM_PASS=
XTREAM_OUTPUT=hls
# Panele dakikada atılacak en fazla istek. Panel ani yığılmada adresi kilitler;
# sağlayıcı bir sayı verirse buraya yazın.
XTREAM_MAX_PER_MINUTE=60

# Çok sesli dosyalar için harici oynatıcı (macOS uygulama adı)
EXTERNAL_PLAYER=VLC
